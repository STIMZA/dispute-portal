LOADER_API_KEY=509dd02a-0db6-2ef2-2a09-1cba0c23d793
# Optional: a DIFFERENT key for the customer-creation API (32+ characters)
PROVISIONER_API_KEY=ee47b2b6-fe95-3a2f-5451-08cedd0e34b5
